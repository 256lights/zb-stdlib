{
	"folders": [
		{
			"path": "."
		}
	],
	"extensions": {
		"recommendations": [
			"sumneko.lua"
		]
	},
	"settings": {
		"Lua.runtime.version": "Lua 5.4",
		"Lua.runtime.builtin": {
			"coroutine": "disable",
			"debug": "disable",
			"io": "disable",
			"math": "enable",
			"os": "disable",
			"package": "disable",
			"string": "enable",
			"table": "enable",
			"utf8": "enable",
		},
		"Lua.workspace.ignoreDir": [
			".vscode",
		],
		"js/ts.tsdk.path": "${workspaceFolder}/.github/actions/setup-zb/node_modules/typescript",
		"[typescript]": {
			"editor.defaultFormatter": "vscode.typescript-language-features",
		},
	}
}
